#!/bin/sh
#
# Pre-push guard for the Carnal Media Model Dashboard.
#
# WHY THIS EXISTS
#   v7.70 shipped a broken stylesheet straight to production. Two CSS comment edits left prose
#   sitting outside the comment, the parser read it as a selector and swallowed every rule after
#   it, and the app rendered completely unstyled while a coworker was mid-task. It reached main
#   because "verification" was `curl | grep "v7.70:"` -- which only proves the file uploaded --
#   and because the release process lived in prose that an assistant could skim.
#
# WHAT IT DOES
#   1. Refuses any push to main unless ALLOW_MAIN_PUSH=1 is set. Promotion to production is a
#      HUMAN decision. Pushing to staging is unrestricted.
#   2. Runs tools/preflight.js before ANY push, so a broken build cannot reach even staging.
#
# HOW THE HUMAN PROMOTES
#   ALLOW_MAIN_PUSH=1 git push origin staging:main
#
# SETUP (once per clone)
#   git config core.hooksPath .githooks
#
# LIMITATION, STATED PLAINLY
#   `git push --no-verify` skips this hook. It is a guardrail, not a cage. Anything with an
#   assistant's hands on the keyboard must still treat main as off-limits by policy, not just
#   because a script said no.

repo_root=$(git rev-parse --show-toplevel 2>/dev/null) || exit 0
cd "$repo_root" || exit 0

blocked=0

# stdin: <local ref> <local sha> <remote ref> <remote sha>
while read -r local_ref local_sha remote_ref remote_sha; do
  [ -z "$remote_ref" ] && continue
  case "$remote_ref" in
    refs/heads/main|refs/heads/master)
      if [ "$ALLOW_MAIN_PUSH" != "1" ]; then
        blocked=1
        echo ""
        echo "  ==================================================================="
        echo "   PUSH TO ${remote_ref#refs/heads/} BLOCKED"
        echo "  ==================================================================="
        echo ""
        echo "   main is production. It auto-deploys to:"
        echo "     https://interview-tool-nwn0.onrender.com"
        echo ""
        echo "   Promoting to production is a human decision, made AFTER a human"
        echo "   has loaded staging in a browser and confirmed it works."
        echo "   A version-marker grep is not verification."
        echo ""
        echo "   To promote deliberately:"
        echo "     ALLOW_MAIN_PUSH=1 git push origin staging:main"
        echo ""
        echo "   Staging is not restricted:"
        echo "     git push origin staging"
        echo ""
        echo "  ==================================================================="
        echo ""
      else
        echo "  [pre-push] ALLOW_MAIN_PUSH=1 set -- allowing push to ${remote_ref#refs/heads/}"
      fi
      ;;
  esac
done

[ "$blocked" = "1" ] && exit 1

# ---- Preflight on every push, staging included -------------------------------
if [ -f tools/preflight.js ]; then
  echo "  [pre-push] running preflight..."
  if ! node tools/preflight.js; then
    echo ""
    echo "  [pre-push] PREFLIGHT FAILED -- push aborted. Nothing was sent."
    echo "  Fix the failures above, or bypass with --no-verify if you know why."
    echo ""
    exit 1
  fi
else
  echo "  [pre-push] WARNING: tools/preflight.js missing, skipping checks"
fi

exit 0
